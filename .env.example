# LLM Provider: gemini (default), groq, deepseek, openai, anthropic
LLM_PROVIDER=gemini

# Provider API keys (only the one matching LLM_PROVIDER is needed)
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: override default model
# LLM_MODEL=gemini-2.5-flash-preview-05-20

# Academic data APIs
SEMANTIC_SCHOLAR_API_KEY=          # free: https://www.semanticscholar.org/product/api
CORE_API_KEY=                      # free: https://core.ac.uk/services/api
SCOPUS_API_KEY=                    # free: https://dev.elsevier.com
UNPAYWALL_EMAIL=your@email.edu     # required for PDF retrieval
CROSSREF_MAILTO=your@email.edu     # for CrossRef polite pool
